# Claude Code IDE configs — personal/user-specific permissions and
# settings. The repo's *shared* Claude config lives in .claude/commands/
# and .claude/hooks/; only the personal `settings.local.json` and
# `settings.json` are excluded.
.claude/settings.local.json
.claude/settings.json
# Simulation test reports (generated by Claude Code hook)
.claude/simulation-reports/

# Arquivos de ambiente - NUNCA ENVIE SUAS SENHAS!
.env
.env.*
!.env.example

# Cache do Python
__pycache__/
*.pyc

# Ambientes virtuais
.venv/
venv/

# Arquivos do Docker
ollama_data/
db_data/

# Arquivos de IDEs
.vscode/
.idea/

# Raw demo recording — the source .mp4 stays local; only the optimized
# .github/media/demo.gif is committed.
.github/media/*.mp4

# Test / lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Documentation (generated/internal, not tracked).
docs/
# Personal interview-prep architecture study guide (kept local).
docs/zenbotz_comprehensive_architecture.md

# Internal planning + tech-debt backlogs (kept local, not pushed to the
# public portfolio repo — they enumerate ongoing work, fixed CVEs, and
# strategic decisions that don't belong in a public history).
plan/
tech_debt/
test_track/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
.qa_report_tmp.json
.qa_run_output.log

# Corpus QA framework — generated artifacts (never commit)
tests/simulation/corpus/extractions/
tests/simulation/corpus/rejected/
tests/simulation/corpus/images/
tests/simulation/corpus/pdfs/
tests/simulation/corpus/.selected_for_validation.json
tests/simulation/corpus/baseline_pool.json
tests/simulation/corpus/prospect_pool.json

# Scraper/runner scratch
tmp_chrome_profile/
.claude/scheduled_tasks.lock
