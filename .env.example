# ===========================================
# ZenBots Environment Variables
# Copy this file to .env and fill in real values
# ===========================================

# --- Environment ---
ENVIRONMENT=development
LOG_FORMAT=text

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/botbuilder

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Auth / Security ---
SECRET_KEY=change-me-to-a-random-string
ENCRYPTION_KEY=change-me-generate-with-python-fernet

# --- OpenAI / LLM ---
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=http://ollama:11434/v1

# --- Groq (Whisper STT for voice messages) ---
GROQ_API_KEY=gsk_...

# --- WhatsApp (Meta) ---
WHATSAPP_TOKEN=your-whatsapp-token
META_VERIFY_TOKEN=your-verify-token
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# --- Facebook Embedded Signup ---
FB_APP_ID=your-fb-app-id
FB_APP_SECRET=your-fb-app-secret

# --- Mercado Pago ---
MP_CLIENT_ID=your-mp-client-id
MP_CLIENT_SECRET=your-mp-client-secret
MP_REDIRECT_URI=http://localhost:3000/pagamentos
MP_ADMIN_ACCESS_TOKEN=your-mp-admin-token
MP_WEBHOOK_SECRET=your-mp-webhook-secret

# --- AWS (S3 menu storage) ---
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_BUCKET_NAME=your-bucket-name
AWS_REGION=us-east-1

# --- Google Maps (address lookup fallback) ---
GOOGLE_MAPS_API_KEY=your-google-maps-key

# --- Email (MailHog for dev) ---
MAIL_USERNAME=test
MAIL_PASSWORD=test
MAIL_FROM=noreply@zenbots.com.br
MAIL_PORT=1025
MAIL_SERVER=mailhog
MAIL_STARTTLS=False
MAIL_SSL_TLS=False
USE_CREDENTIALS=False
VALIDATE_CERTS=False

# --- CORS (production only) ---
# CORS_ORIGINS=https://app.zenbots.com.br
# CORS_ORIGIN_REGEX=

# --- Base URL (for MP redirects, etc.) ---
BASE_URL=http://localhost:3000
